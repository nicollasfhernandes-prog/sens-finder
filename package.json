{
  "name": "sens-finder",
  "productName": "Sens Finder",
  "version": "1.3.1",
  "description": "Encontre sua sensibilidade ideal para Valorant, CS2 e outros FPS",
  "main": "./out/main/index.js",
  "author": "nicollasfhernandes-prog",
  "repository": "github:nicollasfhernandes-prog/sens-finder",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.braianfhernandes.sensfinder",
    "productName": "Sens Finder",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sens Finder",
      "artifactName": "SensFinder-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SensFinder-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nicollasfhernandes-prog",
        "repo": "sens-finder",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
